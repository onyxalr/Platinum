{
  "name": "platinum",
  "version": "0.1.0",
  "private": true,
  "description": "Platinum — локальный музыкальный плеер для Linux на Electron и React Native Web",
  "homepage": "https://github.com/onyxalr/Platinum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyxalr/Platinum.git"
  },
  "bugs": {
    "url": "https://github.com/onyxalr/Platinum/issues"
  },
  "keywords": [
    "music-player",
    "electron",
    "react",
    "linux",
    "local-first",
    "material-you"
  ],
  "desktopName": "Platinum",
  "author": {
    "name": "Platinum",
    "email": "hello@platinum.app"
  },
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5273 && VITE_DEV_SERVER_URL=http://localhost:5273 electron .\"",
    "dev:renderer": "vite",
    "build:electron": "node scripts/build-electron.mjs",
    "watch:electron": "node scripts/build-electron.mjs --watch",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --linux",
    "preview": "vite preview",
    "fetch:ytdlp": "node scripts/fetch-ytdlp.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "lucide-react": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wait-on": "^9.0.1",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "app.platinum.music",
    "productName": "Platinum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "resources/bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "maintainer": "Platinum <hello@platinum.app>",
      "synopsis": "Platinum — музыкальный стриминг"
    }
  }
}
